{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "ios": {
        "buildConfiguration": "Release",
        "cocoapods": "1.15.2"
      },
      "developmentClient": false,
      "distribution": "store",
      "env": {
        "COCOAPODS_DISABLE_STATS": "true",
        "EXPO_USE_FAST_RESOLVER": "1"
      }
    }
  }
}