{
  "expo": {
    "name": "Agronea Producciones",
    "slug": "agro_app_movil_user",
    "version": "1.4.3",
    "orientation": "default",
    "icon": "./assets/logoAgronea3.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/logo_splash_blanco.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agroapp.user",
      "buildNumber": "18",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Agronea Producciones"
      },
      "icon": "./assets/logoAgronea2.png",
      "associatedDomains": [
        "applinks:agronea.store",
        "applinks:www.agronea.store"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoAgronea3.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.agroapp.user",
      "versionCode": 43,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "agronea.store",
              "pathPrefix": "/mis-entradas"
            },
            {
              "scheme": "https",
              "host": "www.agronea.store",
              "pathPrefix": "/mis-entradas"
            },
            {
              "scheme": "https",
              "host": "agronea.store",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "www.agronea.store",
              "pathPrefix": "/i/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/logoAgronea2.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "eas": {
        "projectId": "542dc9de-3794-4562-8c40-b287c953b005"
      }
    },
    "plugins": [
      "expo-font",
      "expo-system-ui",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A8F3C",
          "sounds": []
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Agronea necesita permiso para guardar el croquis del predio en tu galería.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "agronea"
  }
}
