{
  "expo": {
    "name": "Agronea Producciones",
    "slug": "agro_app_movil_user",
    "version": "1.3.6",
    "orientation": "default",
    "icon": "./assets/logoAgronea3.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/logo_splash_blanco.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b5e2c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agroapp.user",
      "buildNumber": "14",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Agronea Producciones"
      },
      "icon": "./assets/logoAgronea2.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoAgronea3.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.agroapp.user",
      "versionCode": 39,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/logoAgronea2.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "eas": {
        "projectId": "542dc9de-3794-4562-8c40-b287c953b005"
      }
    },
    "plugins": [
      "expo-font",
      "expo-system-ui",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logoAgronea3.png",
          "color": "#0A8F3C",
          "sounds": []
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Agronea necesita permiso para guardar el croquis del predio en tu galería.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
